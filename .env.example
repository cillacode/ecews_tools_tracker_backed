# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ──────────────────────────────────────────────────────────────
# Database (PostgreSQL — local or Supabase)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:postgres@localhost:5432/mer_tools
# For Supabase / managed Postgres with SSL, set:
DB_SSL=false

# ──────────────────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=80278f0949bee233c67f3f5ae23a4b584b8a95d776d8ef63772f26ba7a899e3037fc0cfc40c92487471b56454954d5d5158e19ff20d088e8637de9e77ad46c56
JWT_EXPIRES_IN=8h
BCRYPT_COST=10

# ──────────────────────────────────────────────────────────────
# Default admin (used by seed script on first run)
# ──────────────────────────────────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@mer-tools.local
DEFAULT_ADMIN_PASSWORD=changeme123
DEFAULT_ADMIN_NAME=System Administrator

# ──────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
